DATABASE_URL=postgres://homespace:homespace@localhost:5432/homespace
HOMESPACE_JWT_SECRET=change-me-to-a-long-random-string
# Or read it from a file (Docker/Podman secret); set only one of the two:
# HOMESPACE_JWT_SECRET_FILE=/run/secrets/homespace_jwt_secret
# Rotation: put the old secret here while the new one is in use, then remove it after the
# access token lifetime (HOMESPACE_ACCESS_TTL_SECS) has passed.
# HOMESPACE_JWT_SECRET_PREVIOUS=
HOMESPACE_STORAGE_ROOT=./data

# Single sign-on through an OpenID Connect provider (Auth0, Keycloak, ...). Enabled by the issuer.
# Register home-space there as a confidential client with the redirect URI
# <HOMESPACE_PUBLIC_URL>/api/v1/auth/oidc/callback
# HOMESPACE_PUBLIC_URL=https://files.example.com
# HOMESPACE_OIDC_ISSUER=https://example.eu.auth0.com/          # Keycloak: https://kc.example.com/realms/<realm>
# HOMESPACE_OIDC_CLIENT_ID=
# HOMESPACE_OIDC_CLIENT_SECRET=
# HOMESPACE_OIDC_NAME=Auth0                                    # sign-in button label
# HOMESPACE_OIDC_REQUIRED_GROUP=                               # only members of this group may sign in
# HOMESPACE_OIDC_GROUPS_CLAIM=groups                           # Auth0: a namespaced claim added by an Action
# HOMESPACE_PASSWORD_LOGIN=true                                # false: only the provider can sign users in
HOMESPACE_BIND=127.0.0.1:8080
# HOMESPACE_WEB_ROOT=../clients/web/dist
HOMESPACE_MAX_UPLOAD_BYTES=10737418240
# Files larger than one chunk are uploaded in chunks of this size; keep it below the request
# limit of a proxy in front of the server (Cloudflare: 100 MB).
# HOMESPACE_UPLOAD_CHUNK_BYTES=33554432
# HOMESPACE_UPLOAD_EXPIRY_HOURS=24
HOMESPACE_ACCESS_TTL_SECS=900
HOMESPACE_REFRESH_TTL_SECS=2592000
RUST_LOG=info,homespace=debug

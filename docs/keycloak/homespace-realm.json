{
  "realm": "homespace",
  "enabled": true,
  "registrationAllowed": false,
  "groups": [{ "name": "family", "path": "/family" }],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "email": "demo@example.com",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "demo", "temporary": false }],
      "groups": ["/family"]
    }
  ],
  "clients": [
    {
      "clientId": "homespace",
      "name": "Home Space",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "homespace-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:8080/api/v1/auth/oidc/callback",
        "http://127.0.0.1:8081/api/v1/auth/oidc/callback"
      ],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17+ drops connections to private addresses (a home server on the LAN, or the
         emulator's 10.0.2.2) unless this runtime permission is granted; MainActivity asks for it. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- No backups: the saved session can't be read without this device's Keystore key.
         No networkSecurityConfig: the Rust client's sockets don't go through one, and the only
         traffic it governs is the certificate verifier's revocation checks. Those need the
         allow-list in rustls-platform-verifier's own config, which a config here would replace,
         and every Let's Encrypt server would then be reported as revoked. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Where single sign-on comes back to: protocol::paths::MOBILE_OIDC_REDIRECT.
                 singleTask also closes the Custom Tab on top of this activity. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="oidc"
                    android:path="/callback"
                    android:scheme="app.homespace" />
            </intent-filter>
        </activity>
        <!-- Hands downloaded files to viewer apps, read-only; see res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
